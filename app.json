{
  "expo": {
    "name": "AWMD Weather",
    "slug": "onspace-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": ".assets/images/file_000000004ee471fa8a666891e427a7a8 (1).png",
    "scheme": "awmdweather",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": ".assets/images/file_000000004ee471fa8a666891e427a7a8 (1).png",
        "backgroundColor": "#0A1628"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.awmd.weather",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/awmd-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AWMD Weather to use your location for accurate weather data."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/awmd-logo.png",
          "color": "#FFB300"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "265c6178-7cb8-4254-ad9e-9d6309c6b8cb"
      }
    }
  }
}

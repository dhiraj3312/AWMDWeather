{
  "expo": {
    "name": "AWMD Weather",
    "slug": "awmd-weather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/awmd-logo.png",
    "scheme": "awmdweather",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.awmd.weather",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AWMD Weather needs your location to show local weather conditions.",
        "NSLocationAlwaysUsageDescription": "AWMD Weather needs your location to show local weather conditions."
      }
    },
    "android": {
      "package": "com.awmd.weather",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/awmd-logo.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/awmd-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/awmd-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AWMD Weather to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/awmd-logo.png",
          "color": "#F59E0B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

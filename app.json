{
  "expo": {
    "name": "AWMD Weather",
    "slug": "awmd weather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "onspaceapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0A1628"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.awmd.weather"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/awmd-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AWMD Weather to use your location for accurate weather data."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/awmd-logo.png",
          "color": "#FFB300"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
